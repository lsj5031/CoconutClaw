# Telegram polling and Codex only. Paths are relative to --data-dir.
# Precedence: defaults < file < environment. CLI --data-dir overrides
# COCONUTCLAW_DATA_DIR; neither option moves existing data.
# Strings must be TOML strings; numbers must be TOML integers. Invalid supplied
# values are errors, not defaults. Environment numbers use decimal text.
TELEGRAM_BOT_TOKEN = "replace_me"
TELEGRAM_CHAT_ID = "replace_me"
TELEGRAM_CHAT_IDS = ""
TELEGRAM_API_BASE = ""
TELEGRAM_FILE_BASE = ""
TELEGRAM_PARSE_MODE = "off"
TELEGRAM_PARSE_FALLBACK = "plain"
TIMEZONE = "UTC"
SQLITE_DB_PATH = "./state.db"
LOG_DIR = "./LOGS"
ALLOWLIST_PATH = "./config/allowlist.txt"
POLL_INTERVAL_SECONDS = 2
EXEC_POLICY = "safe"
CODEX_BIN = "codex"
CODEX_MODEL = ""
CONTEXT_TURNS = 8
PROVIDER_MAX_RETRIES = 0
PROGRESS_UPDATE_INTERVAL = 3
TELEGRAM_API_TIMEOUT_SECS = 30
TELEGRAM_API_RETRY_ATTEMPTS = 3
PROVIDER_TIMEOUT_SECS = 300
# Numeric domains (inclusive):
# POLL_INTERVAL_SECONDS / PROGRESS_UPDATE_INTERVAL: 1..3600 seconds
# CONTEXT_TURNS: 1..10000; PROVIDER_MAX_RETRIES: 0..10
# TELEGRAM_API_TIMEOUT_SECS: 1..300; TELEGRAM_API_RETRY_ATTEMPTS: 0..10
# PROVIDER_TIMEOUT_SECS: 1..86400 seconds, including stdin/output drain
# Telegram retries exclude the initial attempt: zero means one HTTP attempt.

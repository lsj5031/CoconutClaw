{
  "name": "coconutclaw-gateway-local",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "sh build.sh && node stage.mjs",
    "stage:pilot": "sh build.sh && node stage.mjs phase2-pilot",
    "test:config": "node --test config.test.mjs",
    "check:cf": "CF_SEND_TELEMETRY=false cf deploy --prebuilt --dry-run",
    "check:cf:pilot": "CF_SEND_TELEMETRY=false cf deploy --prebuilt --dry-run --mode phase2-pilot",
    "test": "npm run stage && node --test authority-preflight.test.mjs config.test.mjs integration.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.2",
    "@cloudflare/config": "0.20.0",
    "cf": "1.0.0-beta.5",
    "miniflare": "4.20260730.0"
  },
  "overrides": {
    "miniflare": {
      "workerd": "1.20261123.1"
    }
  }
}
